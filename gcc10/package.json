{
  "name": "gate-cse-2027-command-center",
  "version": "10.0.0",
  "description": "GATE CSE 2027 Command Center",
  "author": "Abhinav",
  "main": "main.js",
  "scripts": {
    "build": "esbuild App.jsx --bundle --minify --outfile=bundle.js --loader:.jsx=jsx --loader:.js=jsx",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "build:web": "npm run build && node scripts/prep-www.js",
    "android": "npm run build:web && npx cap sync android",
    "test": "node sync-core.test.mjs && node timer-engine.test.mjs && node readiness-core.test.mjs && node planner.test.mjs",
    "build:html": "npm run build && node scripts/build-single.js"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@supabase/supabase-js": "^2.58.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/assets": "^3.0.5"
  },
  "build": {
    "appId": "com.abhinav.gatecommandcenter",
    "productName": "GATE CSE 2027 Command Center",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "bundle.js",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    }
  }
}
